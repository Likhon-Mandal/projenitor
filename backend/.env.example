# Server Port
PORT=5001

# Allowed Frontend Client URL(s) for CORS (comma-separated)
CLIENT_URL=http://localhost:5173,https://baraibangsho-client.vercel.app

# Cloud Database Connection String (e.g. Supabase, Neon, Vercel Postgres)
# Pooler Connection (IPv4 & Serverless recommended):
DATABASE_URL=postgresql://postgres.tfnzbjcsjxlelnpsgqkn:your_supabase_password@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
# Direct Connection (IPv6 enabled networks):
# DIRECT_URL=postgresql://postgres:your_supabase_password@db.tfnzbjcsjxlelnpsgqkn.supabase.co:5432/postgres

# Or Individual Fields:
DB_USER=postgres.tfnzbjcsjxlelnpsgqkn
DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
DB_NAME=postgres
DB_PASSWORD=your_supabase_password
DB_PORT=5432
DB_SSL=true

# JWT Secret Key
JWT_SECRET=your_jwt_secret_key_here

# Cloudinary Storage Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Rate Limiting & API Gateway Settings
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=500
AUTH_RATE_LIMIT_MAX=25
