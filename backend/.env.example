# Server Port
PORT=5001

# Allowed Frontend Client URL(s) for CORS (comma-separated)
CLIENT_URL=http://localhost:5173,https://baraibangsho-client.vercel.app

# Database Connection (Individual Fields)
DB_USER=postgres
DB_HOST=localhost
DB_NAME=projenitor_db
DB_PASSWORD=your_db_password
DB_PORT=5432
DB_SSL=false

# Cloud Database Connection String (Use this on Vercel/Supabase/Neon/Render)
# DATABASE_URL=postgresql://user:password@host:port/database?sslmode=require

# JWT Secret Key
JWT_SECRET=your_jwt_secret_key_here

# Cloudinary Storage Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Rate Limiting & API Gateway Settings
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=500
AUTH_RATE_LIMIT_MAX=25
