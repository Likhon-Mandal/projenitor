# Backend API Base URL
# - In local development: leave empty to use Vite internal reverse proxy (/api)
# - In Vercel / Production: set to your deployed backend API URL (e.g. https://baraibangsho-backend.vercel.app/api)
VITE_API_URL=https://baraibangsho-backend.vercel.app/api

# Vite dev server reverse proxy target (default: http://127.0.0.1:5001)
VITE_BACKEND_URL=http://127.0.0.1:5001

# Application Name
VITE_APP_NAME="বাড়ৈ বংশ"

